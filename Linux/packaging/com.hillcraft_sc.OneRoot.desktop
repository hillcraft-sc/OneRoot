[Desktop Entry]
Type=Application
Name=OneRoot
GenericName=File Manager
Comment=A fast, native file manager with tabs, dual pane and a folder tree
Exec=oneroot %U
Icon=com.hillcraft_sc.OneRoot
Terminal=false
Categories=System;FileTools;FileManager;
